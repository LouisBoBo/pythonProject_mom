# Copy to desktop/update-upload.env (git-ignored) and fill in the SSH key path.
# Packaging reads this file automatically; real process environment wins over it.

# Private key that can log in to the company server without a prompt.
WORKBUDDY_DESKTOP_SSH_KEY=/Users/you/.ssh/id_ed25519

WORKBUDDY_DESKTOP_HOST=175.178.238.31
WORKBUDDY_DESKTOP_USER=root
WORKBUDDY_DESKTOP_PORT=22

# Dedicated directory for the MOM installer. Never point this at
# /www/wwwroot/workbuddy-desktop, which serves the other product.
WORKBUDDY_DESKTOP_REMOTE_DIR=/www/wwwroot/dsh-mom-desktop

# Installers to keep on the server per platform (the newest N).
WORKBUDDY_DESKTOP_KEEP=2

# Public URL the desktop app reads. It is served by the company gateway on
# 8443 (same TLS certificate the app already trusts), mapped to
# WORKBUDDY_DESKTOP_REMOTE_DIR.
ZR_MOM_UPDATE_FEED_BASE=https://175.178.238.31:8443/dsh-mom-desktop/

# Optional release note shown in the update prompt.
# ZR_MOM_UPDATE_NOTES=修复若干问题。

# Packaging does not read this file; export the build version in the shell
# before running a release build, or installed clients will not see the update:
#   DSH_DESKTOP_BUILD_VERSION=0.2.1-rc.2.20261102.1 ./desktop/package-macos.sh
# The value must extend the product version (0.2.1-rc.2).

# Set to 1 to build without publishing (the feed is still written to dist/).
# WORKBUDDY_DESKTOP_SKIP_UPLOAD=1
