# Local unsigned packaging. No signing PIN and no upload credentials.
DSH_DESKTOP_APP_ID=local.dsh.mom.desktop
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://example.com
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG={"allowedAuthOrigins":["https://example.com"]}
